# 生产「各节点必须一致」的数据库参数(Patroni 命令行会盖掉库内设置,必须等于现主库)。
# 来源(2026-11-08 取得):现主库 postgresql.auto.conf(max_connections=2000)+ 镜像自带 postgresql.conf
# (wal_level=logical、max_wal_senders=10、max_replication_slots=5)+ Postgres 缺省(其余)。
# 上线前必须用 production/README.md 里的查询在现主库核对 —— 与这里不同则以主库为准改这里。
PT_PG_PORT=5433
PT_REST_PORT=8008
PT_MAX_CONNECTIONS=2000
PT_MAX_WAL_SENDERS=10
PT_MAX_REPLICATION_SLOTS=5
PT_MAX_WORKER_PROCESSES=8
PT_MAX_LOCKS_PER_TRANSACTION=64
PT_MAX_PREPARED_TRANSACTIONS=0
