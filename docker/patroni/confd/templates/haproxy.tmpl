# 库入口(Patroni 官方 HAProxy 模板的写法):每秒问每个成员 /primary,只转给主;
# 一个后端被判下线的那一刻掐断所有经它的连接,客户端连接池立刻重连到新主。
global
    maxconn 4000
    server-state-file /tmp/primary-startup.state
    # 重载后旧进程不再检查后端,最多保留旧会话 30 秒,然后由客户端重连。
    hard-stop-after 30s
    stats socket /tmp/haproxy.sock mode 600 level admin

defaults
    load-server-state-from-file global
    mode tcp
    log global
    retries 2
    timeout connect 3s
    timeout client 1h
    timeout server 1h
    timeout check 2s
    option clitcpka
    option srvtcpka

listen pg_primary
    bind *:{{getenv "ENTRY_PORT"}}
    option httpchk GET /primary
    http-check expect status 200
    # 首次提升后新主上线即关闭旧主备用会话,避免长连接继续写入旧时间线。
    default-server inter 1s fall 2 rise 2 on-marked-down shutdown-sessions on-marked-up shutdown-backup-sessions check-ssl verify required ca-file /tls/ca.crt crt /tls/node.pem
# BEGIN-SERVERS
{{range gets "/members/*"}}{{$d := json .Value}}    server {{base .Key}} {{index (split (index (split $d.conn_url "/") 2) ":") 0}}:{{index (split (index (split $d.conn_url "/") 2) ":") 1}} check port {{index (split (index (split $d.api_url "/") 2) ":") 1}}
{{end}}# END-SERVERS
# 迁移期:旧主库当「备用后端」(不做健康检查,只在 Patroni 成员里没有主的时候接流量);迁移完成后清空 ENTRY_BACKUP
{{if getenv "ENTRY_BACKUP"}}    server legacy {{getenv "ENTRY_BACKUP"}} backup
{{end}}
# 平台健康探针:入口进程在跑就回 200
frontend health
    mode http
    bind *:8009
    monitor-uri /health
